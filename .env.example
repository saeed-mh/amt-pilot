# Development-only Docker Compose defaults
POSTGRES_DB=amtpilot
POSTGRES_USER=amtpilot
POSTGRES_PASSWORD=amtpilot

# Spring Boot datasource overrides, if needed
DB_URL=jdbc:postgresql://localhost:5432/amtpilot
DB_USERNAME=amtpilot
DB_PASSWORD=amtpilot

# JWT configuration
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Uploaded document storage
UPLOAD_DIR=./uploads

# AI document analysis
GOOGLE_API_KEY=replace-with-your-google-ai-api-key
GOOGLE_MODEL=gemini-3.5-flash-lite
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
AI_RETRIEVAL_LIMIT=5

# Local OCR fallback for scanned PDFs
OCR_ENABLED=true
OCR_COMMAND=ocrmypdf
OCR_LANGUAGES=deu+eng
# Optional full Tesseract tessdata directory, including configs and language files
OCR_TESSDATA_PREFIX=
OCR_TIMEOUT_SECONDS=120
OCR_MAX_PAGES=20
OCR_MIN_TEXT_CHARACTERS=20

# Spring Boot connection to the Python AI service
AI_SERVICE_URL=http://localhost:8000
